{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "control-center-margin-top": 10,
    "control-center-margin-bottom": 0,
    "control-center-margin-right": 10,
    "control-center-margin-left": 0,
    "notification-body-image-height": 200,
    "notification-body-image-width": 200,

    "timeout": 4,
    "timeout-low": 2,
    "timeout-critical": 0,

    "fit-to-screen": true,
    "_comment": "The quick-action row and cards are sized in style.css.",
    "control-center-width": 460,
    "notification-window-width": 480,
    "keyboard-shortcuts": true,
    "notification-grouping": false,
    "image-visibility": "when-available",
    "transition-time": 0,

    "hide-on-clear": false,
    "hide-on-action": true,
    
    "widgets": [
        "buttons-grid#account-actions",
        "volume",
        "backlight",
        "buttons-grid#quick-actions",
        "notifications",
        "buttons-grid#power-actions",
        "buttons-grid#profile-actions"
    ],
    "widget-config": {
        "buttons-grid#account-actions": {
            "actions": [
                {
                    "label": "starrk\nCachyOS",
                    "command": ":"
                },
                {
                    "label": "󰍃",
                    "command": "$HOME/.local/bin/exit.sh"
                }
            ]
        },
        "volume": {
            "label": ""
        },
        "backlight": {
            "label": "󰖨"
        },
        "notifications": {
        },
        "buttons-grid#quick-actions": {
            "actions": [
                {
                    "label": "󰖩",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off >/dev/null 2>&1'",
                    "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
                },
                {
                    "label": "󰂯",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off >/dev/null 2>&1'",
                    "update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
                },
                {
                    "label": "󰝟",
                    "type": "toggle",
                    "active": true,
                    "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1",
                    "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q 'MUTED' && echo true || echo false"
                },
                {
                    "label": "󰒳",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/idle_inhibit.sh --toggle >/dev/null 2>&1",
                    "update-command": "$HOME/.local/bin/idle_inhibit.sh --check >/dev/null 2>&1 && echo true || echo false"
                },
                {
                    "label": "󰆧",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c 'swaync-client --close-panel >/dev/null 2>&1; \"$HOME/.local/bin/tobimune_shell_mode.sh\" --toggle >/dev/null 2>&1; swaync-client --open-panel >/dev/null 2>&1'",
                    "update-command": "cat $HOME/.local/state/tobimune/state/tobimune_shell_state | grep -q '1' && echo true || echo false"
                }
            ]
        },
        "buttons-grid#power-actions": {
            "actions": [
                {
                    "label": "󰑓",
                    "command": "systemctl reboot"
                },
                {
                    "label": "",
                    "command": "$HOME/.local/bin/lock.sh"
                },
                {
                    "label": "󰤄",
                    "command": "systemctl suspend"
                },
                {
                    "label": "󰤆",
                    "command": "systemctl poweroff"
                }
            ]
        },
        "buttons-grid#profile-actions": {
            "actions": [
                {
                    "label": "󱓞 Ahorro",
                    "command": "powerprofilesctl set power-saver"
                },
                {
                    "label": "󰾅 Balance",
                    "command": "powerprofilesctl set balanced"
                },
                {
                    "label": "󰓅 Rend.",
                    "command": "powerprofilesctl set performance"
                }
            ]
        }
    }
}
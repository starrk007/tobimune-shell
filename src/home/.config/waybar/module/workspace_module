{
    "group/hworkspaces": {
        "orientation": "horizontal",
        "modules": [
            "ext/workspaces"
        ]
    },

    "group/vworkspaces": {
        "orientation": "vertical",
        "modules": [
            "ext/workspaces"
        ]
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "sort-by-number": true,
        "show-special": true,
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
	    }
    },

    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "sort-by-direction": "true"
    }
}
// Tobimune Shell Rofi Theme
// Theme: line.rasi
// Main application launcher theme for Tobimune Shell.

@import "../../../.local/state/tobimune/theme/rofi-style.rasi"

/* ===== GLOBAL VARIABLES ===== */
* {
    background:          @system-background;
    foreground:          #e7e2e7;
    background-color:    transparent;
    text-color:          @foreground;
    border-color:        @accent-dim;
    margin:              0;
    padding:             0;
    spacing:             0;
}

/* ===== MAIN WINDOW ===== */
window {
    width:               35%;
    height:              43%;
    background-color:    @background;
    border:              2px;
    border-color:        @accent;
    border-radius:       3px;
    padding:             14px 16px;
}

mainbox {
    spacing:             8px;
    children:            [ inputbar, listview ];
}

/* ===== INPUT BAR ===== */
inputbar {
    children:            [ prompt, entry ];
    border:              0 0 1px 0;
    border-color:        rgba(255, 255, 255, 0.14);
    padding:              0 0 7px 0;
}

prompt {
    padding:             2px 8px 2px 0;
    text-color:          @accent;
}

entry {
    padding:             2px 0;
    text-color:          @foreground;
    placeholder:         "Search";
    placeholder-color:   rgba(231, 226, 231, 0.42);
}

/* ===== LISTVIEW ===== */
listview {
    scrollbar:           false;
    cycle:               true;
    dynamic:             true;
    spacing:             2px;
    padding:             2px 0;
}

/* ===== ELEMENTS ===== */
element {
    padding:             6px 8px;
    margin:              0;
    orientation:         horizontal;
    vertical-align:      0.5;
    border-radius:       2px;
}

element-icon {
    size:                20px;
    margin:              0 9px 0 0;
    vertical-align:      0.5;
}

element-text {
    text-color:          @foreground;
    vertical-align:      0.5;
}

/* ===== ELEMENT STATES ===== */
element selected {
    background-color:    @accent-dim;
}

element-text selected {
    text-color:          @foreground;
}